{
  "build": {
    "content": [
      {
        "files": [
          "articles/**.md",
          "articles/toc.md",
          "*.md",
          "toc.yml"
        ],
        "exclude": [
          "**/bin/**",
          "**/obj/**",
	        "**/includes/**",
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "**/*.jpg",
          "**/*.jpeg",
          "**/*.png",
          "**/*.gif",
          "**/*.html",
          "**/*.pdf",
          "**/*.xlsx",
          "**/*.pptx",
          "**/*.csv",
          "**/*.xml",
          "**/*.ttf",
          "**/*.webp",
          "**/*.ico",
          "**/*.mp4",
          "**/*.css",
          "**/*.js",
          "**/*.mp3",
          "**/*.json",
          "**/*.css",
          "**/*.hls",
          "**/*.m3u8",
          "**/*.ts",
          "**/*.svg",
          "**/*.txt",          
          "**/*.woff"
        ],
        "exclude": [
          "**/bin/**",
          "**/obj/**",
	        "**/includes/**",
          "_site/**"
        ]
      }
    ],
    "overwrite": [],
    "dest": "D:/Synfynal/woocommerce-connector-docs/docs",
    "template": [
      "default",
      "D:/Synfynal/woocommerce-connector-docs/Templates/SingulinkFX/singulinkfx"

    ],
    "postProcessors": [ 
      "ExtractSearchIndex",
      "SitemapGenerator"
       ],
"globalMetadata": {
    "_appTitle": "WooCommerce Connector Help",
    "_appName": "",
    "_appFaviconPath": "articles/media/favicon.ico",
    "_appLogoPath": "articles/media/logo.png",
    "_appFooter": "© 2025 by Synfynal",
    "_copyrightFooter": "© 2025 by Synfynal",
    "_enableSearch": true,
    "_disableSideFilter": false,
    "_enableNewTab": true,
    "_disableContribution": true,
    "_disableBreadcrumb": false
},
    "sitemap": {
      "baseUrl": "https://help.synfynal.com/",
      "priority": 0.5,
      "changefreq": "weekly"
    }
  }
  
}